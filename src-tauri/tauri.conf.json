{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapper",
  "version": "0.1.0",
  "identifier": "dev.lavoie.zapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "zapper",
        "width": 1400,
        "height": 860,
        "transparent": false,
        "decorations": false,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "license": "MIT",
    "copyright": "© 2026 Francis Lavoie",
    "shortDescription": "A fast Xtream live-TV client",
    "longDescription": "A live-TV client for Xtream Codes panels: instant channel switching, a full guide, catch-up, and a picture that keeps playing while you browse.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/zapper.desktop.hbs",
        "depends": [
          "libmpv2 | libmpv1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/lib/zapper/install-kind": "../packaging/install-kind-deb",
          "/usr/share/doc/zapper/copyright": "target/licenses/copyright",
          "/usr/share/doc/zapper/LICENSE": "../LICENSE",
          "/usr/share/doc/zapper/MPV-FFMPEG-NOTICE.txt": "../packaging/licenses/MPV-FFMPEG-NOTICE.txt",
          "/usr/share/doc/zapper/THIRD-PARTY-NOTICES-rust.txt": "target/licenses/THIRD-PARTY-NOTICES-rust.txt",
          "/usr/share/doc/zapper/THIRD-PARTY-NOTICES-ui.txt": "../dist/licenses/THIRD-PARTY-NOTICES-ui.txt"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/zapper.desktop.hbs",
        "depends": [
          "libmpv.so.2()(64bit)",
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)"
        ],
        "files": {
          "/usr/lib/zapper/install-kind": "../packaging/install-kind-rpm",
          "/usr/share/licenses/zapper/LICENSE": "../LICENSE",
          "/usr/share/licenses/zapper/MPV-FFMPEG-NOTICE.txt": "../packaging/licenses/MPV-FFMPEG-NOTICE.txt",
          "/usr/share/licenses/zapper/THIRD-PARTY-NOTICES-rust.txt": "target/licenses/THIRD-PARTY-NOTICES-rust.txt",
          "/usr/share/licenses/zapper/THIRD-PARTY-NOTICES-ui.txt": "../dist/licenses/THIRD-PARTY-NOTICES-ui.txt"
        }
      }
    }
  }
}

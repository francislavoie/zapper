{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapper",
  "version": "0.1.0",
  "identifier": "dev.lavoie.zapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "zapper",
        "width": 1400,
        "height": 860,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/icon.png"
    ]
  }
}

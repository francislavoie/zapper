{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapper",
  "version": "0.1.0",
  "identifier": "dev.lavoie.zapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "zapper",
        "width": 1400,
        "height": 860,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}

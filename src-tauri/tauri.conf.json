{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapper",
  "version": "0.1.0",
  "identifier": "dev.lavoie.zapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "zapper",
        "width": 1400,
        "height": 860,
        "transparent": false,
        "decorations": false,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "license": "MIT",
    "copyright": "© 2026 Francis Lavoie",
    "shortDescription": "A fast live-TV client",
    "longDescription": "A live-TV client for Xtream Codes servers, M3U playlists, HDHomeRun tuners and Tvheadend: instant channel switching, a full guide, catch-up, and a picture that keeps playing while you browse.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/zapper.desktop.hbs",
        "preRemoveScript": "../packaging/linux/deb-prerm",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libva2",
          "libva-drm2",
          "libva-wayland2",
          "libdrm2",
          "libegl1",
          "libwayland-client0",
          "libwayland-cursor0",
          "libwayland-egl1",
          "libxkbcommon0",
          "libasound2t64 | libasound2",
          "libpulse0",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libssl3t64 | libssl3",
          "libfreetype6",
          "libharfbuzz0b",
          "libfribidi0",
          "libfontconfig1",
          "libstdc++6",
          "libgcc-s1",
          "zlib1g"
        ],
        "files": {
          "/usr/lib/zapper/install-kind": "../packaging/install-kind-deb",
          "/usr/bin/zapper-server": "target/release/zapper-server",
          "/usr/lib/zapper/libmpv.so.2": "lib/linux-x86_64/runtime/libmpv.so.2",
          "/usr/lib/zapper/libavutil.so.60": "lib/linux-x86_64/runtime/libavutil.so.60",
          "/usr/lib/zapper/libavcodec.so.62": "lib/linux-x86_64/runtime/libavcodec.so.62",
          "/usr/lib/zapper/libavformat.so.62": "lib/linux-x86_64/runtime/libavformat.so.62",
          "/usr/lib/zapper/libavfilter.so.11": "lib/linux-x86_64/runtime/libavfilter.so.11",
          "/usr/lib/zapper/libavdevice.so.62": "lib/linux-x86_64/runtime/libavdevice.so.62",
          "/usr/lib/zapper/libswscale.so.9": "lib/linux-x86_64/runtime/libswscale.so.9",
          "/usr/lib/zapper/libswresample.so.6": "lib/linux-x86_64/runtime/libswresample.so.6",
          "/usr/share/doc/zapper/copyright": "target/licenses/copyright",
          "/usr/share/doc/zapper/LICENSE": "../LICENSE",
          "/usr/share/doc/zapper/MPV-FFMPEG-NOTICE.txt": "../packaging/licenses/MPV-FFMPEG-NOTICE.txt",
          "/usr/share/doc/zapper/THIRD-PARTY-NOTICES-libmpv.txt": "lib/linux-x86_64/THIRD-PARTY-NOTICES-libmpv.txt",
          "/usr/share/doc/zapper/THIRD-PARTY-NOTICES-rust.txt": "target/licenses/THIRD-PARTY-NOTICES-rust.txt",
          "/usr/share/doc/zapper/THIRD-PARTY-NOTICES-ui.txt": "../dist/licenses/THIRD-PARTY-NOTICES-ui.txt"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/zapper.desktop.hbs",
        "preRemoveScript": "../packaging/linux/rpm-preun",
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libva.so.2()(64bit)",
          "libva-drm.so.2()(64bit)",
          "libva-wayland.so.2()(64bit)",
          "libdrm.so.2()(64bit)",
          "libEGL.so.1()(64bit)",
          "libwayland-client.so.0()(64bit)",
          "libwayland-cursor.so.0()(64bit)",
          "libwayland-egl.so.1()(64bit)",
          "libxkbcommon.so.0()(64bit)",
          "libasound.so.2()(64bit)",
          "libpulse.so.0()(64bit)",
          "libpipewire-0.3.so.0()(64bit)",
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)",
          "libfreetype.so.6()(64bit)",
          "libharfbuzz.so.0()(64bit)",
          "libfribidi.so.0()(64bit)",
          "libfontconfig.so.1()(64bit)",
          "libstdc++.so.6()(64bit)",
          "libgcc_s.so.1()(64bit)",
          "libz.so.1()(64bit)"
        ],
        "files": {
          "/usr/lib/zapper/install-kind": "../packaging/install-kind-rpm",
          "/usr/bin/zapper-server": "target/release/zapper-server",
          "/usr/lib/zapper/libmpv.so.2": "lib/linux-x86_64/runtime/libmpv.so.2",
          "/usr/lib/zapper/libavutil.so.60": "lib/linux-x86_64/runtime/libavutil.so.60",
          "/usr/lib/zapper/libavcodec.so.62": "lib/linux-x86_64/runtime/libavcodec.so.62",
          "/usr/lib/zapper/libavformat.so.62": "lib/linux-x86_64/runtime/libavformat.so.62",
          "/usr/lib/zapper/libavfilter.so.11": "lib/linux-x86_64/runtime/libavfilter.so.11",
          "/usr/lib/zapper/libavdevice.so.62": "lib/linux-x86_64/runtime/libavdevice.so.62",
          "/usr/lib/zapper/libswscale.so.9": "lib/linux-x86_64/runtime/libswscale.so.9",
          "/usr/lib/zapper/libswresample.so.6": "lib/linux-x86_64/runtime/libswresample.so.6",
          "/usr/share/licenses/zapper/LICENSE": "../LICENSE",
          "/usr/share/licenses/zapper/MPV-FFMPEG-NOTICE.txt": "../packaging/licenses/MPV-FFMPEG-NOTICE.txt",
          "/usr/share/licenses/zapper/THIRD-PARTY-NOTICES-libmpv.txt": "lib/linux-x86_64/THIRD-PARTY-NOTICES-libmpv.txt",
          "/usr/share/licenses/zapper/THIRD-PARTY-NOTICES-rust.txt": "target/licenses/THIRD-PARTY-NOTICES-rust.txt",
          "/usr/share/licenses/zapper/THIRD-PARTY-NOTICES-ui.txt": "../dist/licenses/THIRD-PARTY-NOTICES-ui.txt"
        }
      }
    }
  }
}

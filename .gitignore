/target
**/target
node_modules/
dist-app/
*.mp4
*.ts
!src/**/*.ts
# `*.ts` is for MPEG-TS streams; config files are TypeScript too.
!/vite.config.ts
.env
/dist

# local tool state and worktrees; never commit them
.claude/

# test stream fixtures live in ~/.cache/zapper/fixtures (tools/make_fixtures.sh), never here
*.ts.fixture

# browser-automation artifacts: screenshots and console logs, not source
.playwright-mcp/

# The bundled libmpv, as scripts/fetch-libmpv.sh (tools/fetch-libmpv.ps1 on Windows) unpacks
# it, and `just build-libmpv`'s build trees: never committed. See docs/licensing.md.
/src-tauri/lib/
/target-libmpv/

# Python bytecode, written when the stand-in servers under tools/ are run or checked.
__pycache__/

/target
**/target
node_modules/
dist-app/
*.mp4
*.ts
!src/**/*.ts
# `*.ts` is for MPEG-TS streams; config files are TypeScript too.
!/vite.config.ts
.env
/dist

# local tool state and worktrees; never commit them
.claude/

# test stream fixtures live in ~/.cache/zapper/fixtures (tools/make_fixtures.sh), never here
*.ts.fixture

# browser-automation artifacts: screenshots and console logs, not source
.playwright-mcp/

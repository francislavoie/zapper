[Desktop Entry]
Type=Application
Name=zapper
GenericName=Live TV
Comment=A fast Xtream live-TV client
Exec=zapper
Icon=zapper
Terminal=false
Categories=AudioVideo;Video;TV;Player;
Keywords=iptv;tv;xtream;live;
StartupNotify=true
# The link between the running window and this file. On Wayland the
# compositor pairs the toplevel's app_id with a desktop file, and that is
# the only way the window gets an icon — see APP_ID in src-tauri/src/lib.rs,
# which sets the app_id to exactly this.
StartupWMClass=zapper

[Desktop Entry]
Type=Application
Categories={{categories}}
Name={{name}}
GenericName=Live TV
Comment={{comment}}
Exec={{exec}} {{exec_arg}}
Icon={{icon}}
Terminal=false
StartupNotify=true
Keywords=iptv;tv;xtream;live;
# The link between the running window and this file. On Wayland the
# compositor pairs the toplevel's app_id with a desktop file, and that is the
# only way the window gets an icon — see APP_ID in src-tauri/src/lib.rs.
StartupWMClass=zapper

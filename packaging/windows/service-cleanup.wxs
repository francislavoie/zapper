<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI's half of removing the recording service with zapper
  (packaging/windows/installers.conf.json: wix.fragmentPaths, and
  componentGroupRefs to pull this fragment in; Tauri bundles with WiX 3).

  Settings > Recording installs the service as a scheduled task per user,
  zapper-server-<user>, with "zapper" as its author
  (src-tauri/src/recording/service.rs). They are the users' own tasks, so
  only a process running as SYSTEM sees them all: a deferred action that does
  not impersonate. On a full removal only, never on the removal half of an
  upgrade (UPGRADINGPRODUCTCODE), it stops and deletes every such task, before
  the files go, so that none is left starting a program that is gone. It runs
  in the installer service's session, so no window shows; a failure is
  ignored rather than holding the uninstall back.

  With Settings > Recording > Start at boot it is instead a Windows service of
  the same name, zapper-server-<user>, running this folder's zapper-server.exe
  as an account of its own (recording::service::winsvc). The same action
  stops and deletes every such service that runs this installation's
  program: stopping one through the Service
  Control Manager is how it is stopped cleanly.

  The script, which has no [ ] or { } for Windows Installer to read as
  properties but [INSTALLDIR], meant as one (only this installation's
  services; a per-user setup's are its own uninstaller's):

    $tasks = Get-ScheduledTask -TaskName 'zapper-server-*' | Where-Object Author -EQ 'zapper'
    $tasks | Stop-ScheduledTask
    $tasks | Unregister-ScheduledTask -Confirm:$false
    $svcs = @(Get-CimInstance Win32_Service | Where-Object Name -Like 'zapper-server-*' |
              Where-Object PathName -Like '*[INSTALLDIR]zapper-server.exe*')
    $svcs | Stop-Service -Force
    $svcs | Invoke-CimMethod -MethodName Delete

  And after the files are installed (an install, a repair, an upgrade), it
  starts every such service set to start automatically that is not running,
  as the NSIS setup starts the task and the service again: the stop before
  the files were replaced had stopped them.

  The per-user NSIS setup does the same for its user from its uninstaller
  (packaging/windows/installer-hooks.nsh).

  Before any file is replaced or removed (an upgrade, a repair, a removal),
  the installed zapper-server.exe stops the service of the user running the
  MSI cleanly (zapper-server.exe told to stop for setup): what it recorded is
  finished into playable files. That user's token is theirs to read, which
  only an immediate action, impersonating them, can do. In full UI it asks
  first when a recording is in progress; if the answer is no, it
  leaves the service running and Windows Installer's own files-in-use dialog
  follows, which can cancel. The action itself cannot: an EXE custom action
  can only fail an MSI, with a generic error, and one that must succeed could
  keep a damaged install from being removed, so its result is ignored. Other
  users' services are not reached: on removal the action above ends their
  tasks; on an upgrade their running copies are files in use.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Empty: what the main template references to link this fragment. -->
    <ComponentGroup Id="ZapperServiceCleanup" />

    <CustomAction Id="ZapperRemoveServiceTasks"
                  Directory="TARGETDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$tasks = Get-ScheduledTask -TaskName 'zapper-server-*' -ErrorAction SilentlyContinue | Where-Object Author -EQ 'zapper'; $tasks | Stop-ScheduledTask -ErrorAction SilentlyContinue; $tasks | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue; $svcs = @(Get-CimInstance Win32_Service -ErrorAction SilentlyContinue | Where-Object Name -Like 'zapper-server-*' | Where-Object PathName -Like '*[INSTALLDIR]zapper-server.exe*'); $svcs | Stop-Service -Force -ErrorAction SilentlyContinue; $svcs | Invoke-CimMethod -MethodName Delete -ErrorAction SilentlyContinue | Out-Null&quot;" />

    <CustomAction Id="ZapperStartServices"
                  Directory="TARGETDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-CimInstance Win32_Service -ErrorAction SilentlyContinue | Where-Object Name -Like 'zapper-server-*' | Where-Object PathName -Like '*[INSTALLDIR]zapper-server.exe*' | Where-Object StartMode -EQ 'Auto' | Where-Object State -EQ 'Stopped' | Start-Service -ErrorAction SilentlyContinue&quot;" />

    <CustomAction Id="ZapperStopServiceAsk"
                  Directory="INSTALLDIR"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore"
                  ExeCommand="&quot;[INSTALLDIR]zapper-server.exe&quot; --stop-for-setup --ask" />
    <CustomAction Id="ZapperStopServiceQuiet"
                  Directory="INSTALLDIR"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore"
                  ExeCommand="&quot;[INSTALLDIR]zapper-server.exe&quot; --stop-for-setup" />

    <InstallExecuteSequence>
      <!-- Installed: a repair or removal of this one; WIX_UPGRADE_DETECTED: an
           older one is being replaced. Before InstallValidate, which looks for
           files in use. -->
      <Custom Action="ZapperStopServiceAsk" Before="InstallValidate">(Installed OR WIX_UPGRADE_DETECTED) AND UILevel &gt;= 5</Custom>
      <Custom Action="ZapperStopServiceQuiet" Before="InstallValidate">(Installed OR WIX_UPGRADE_DETECTED) AND UILevel &lt; 5</Custom>
      <Custom Action="ZapperRemoveServiceTasks" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="ZapperStartServices" After="InstallFiles">NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
